          },
          "plan": {
            "max": 1
          },
          "previousYear": {
            "max": 1
          },
          "forecast": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "axis"
              }
            },
            {
              "for": {
                "in": "smallMultiple"
              }
            },
            {
              "for": {
                "in": "legend"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "secondaryValues"
              }
